<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FF5429"/>
      <stop offset="50%" stop-color="#F2810C"/>
      <stop offset="100%" stop-color="#D97706"/>
    </linearGradient>
    <linearGradient id="qrGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#FFF8E7"/>
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#7C2D12" flood-opacity="0.35"/>
    </filter>
  </defs>
  
  <!-- Outer Rounded Square Medallion -->
  <rect x="32" y="32" width="448" height="448" rx="128" fill="url(#bgGrad)" filter="url(#shadow)"/>
  <rect x="44" y="44" width="424" height="424" rx="116" fill="none" stroke="#FFFFFF" stroke-opacity="0.3" stroke-width="8"/>
  
  <!-- Stylized Camera & QR Combination Motif -->
  <!-- Top Left Finder Corner -->
  <rect x="112" y="112" width="112" height="112" rx="28" fill="url(#qrGrad)"/>
  <rect x="140" y="140" width="56" height="56" rx="14" fill="#F2810C"/>
  
  <!-- Top Right Finder Corner -->
  <rect x="288" y="112" width="112" height="112" rx="28" fill="url(#qrGrad)"/>
  <rect x="316" y="140" width="56" height="56" rx="14" fill="#F2810C"/>
  
  <!-- Bottom Left Finder Corner -->
  <rect x="112" y="288" width="112" height="112" rx="28" fill="url(#qrGrad)"/>
  <rect x="140" y="316" width="56" height="56" rx="14" fill="#F2810C"/>
  
  <!-- Bottom Right Camera Shutter Core -->
  <circle cx="344" cy="344" r="52" fill="url(#qrGrad)"/>
  <circle cx="344" cy="344" r="26" fill="#D97706"/>
  
  <!-- Center Celebration Sparkle Star -->
  <path d="M 256 184 Q 256 256 184 256 Q 256 256 256 328 Q 256 256 328 256 Q 256 256 256 184 Z" fill="#FFFFFF"/>
</svg>
