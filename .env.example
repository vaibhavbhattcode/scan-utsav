# ScanUtsav Environment Variables
NODE_ENV=development
PORT=3000

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Database URI
MONGODB_URI=mongodb://localhost:27017/scanutsav

# JWT Secret Keys (Generate with crypto.randomBytes(64).toString('hex'))
JWT_SECRET=d8f4e1a9b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1
JWT_REFRESH_SECRET=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=scanutsav-demo
