# ScanUtsav Environment Variables Template
NODE_ENV=development
PORT=3000

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Database URI
MONGODB_URI=mongodb://localhost:27017/scanutsav

# JWT Secret Keys (Generate secure 64-byte random strings for production)
JWT_SECRET=your_jwt_secret_change_me_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_me_in_production

# Google OAuth Client ID (Required for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Cloudinary Configuration (Required for guest photo/video uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Configuration (Required for payments & subscriptions)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Resend Email Configuration (Required for gift pass & notification emails)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=ScanUtsav <no-reply@scanutsav.com>

# Redis Configuration (For Rate-Limiting & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Initial Super Admin Seed Credentials (Used only by npm run seed:admin)
INITIAL_ADMIN_EMAIL=admin@scanutsav.com
INITIAL_ADMIN_PASSWORD=change_this_admin_password_123!
